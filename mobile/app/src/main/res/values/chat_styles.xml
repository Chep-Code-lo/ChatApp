<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.Chat.Chip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/chat_chip_background</item>
        <item name="android:textColor">@color/chat_chip_text</item>
        <item name="android:fontFamily">@font/manrope_semibold</item>
        <item name="android:textSize">13sp</item>
        <item name="chipMinHeight">40dp</item>
        <item name="chipCornerRadius">24dp</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="ensureMinTouchTargetSize">true</item>
    </style>
    <style name="ShapeAppearance.Chat.Attachment" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>
</resources>
