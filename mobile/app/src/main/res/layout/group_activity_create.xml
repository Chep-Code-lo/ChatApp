<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:id="@id/groupScreenRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/group_ui_background" tools:context=".group.GroupCreateActivity">
    <include layout="@layout/group_toolbar" />
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="8dp" android:paddingBottom="20dp">
            <com.google.android.material.card.MaterialCardView android:layout_width="72dp" android:layout_height="72dp" android:layout_marginTop="24dp" app:cardBackgroundColor="@color/group_ui_accent" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:strokeWidth="0dp">
                <androidx.appcompat.widget.AppCompatImageView android:layout_width="36dp" android:layout_height="36dp" android:layout_gravity="center" app:srcCompat="@drawable/lucide_users" app:tint="@color/group_ui_on_accent" android:importantForAccessibility="no" />
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/groupNameLayout" style="@style/Widget.Group.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:hint="@string/group_ui_name_label" app:helperText="@string/group_ui_name_helper" app:counterEnabled="true" app:counterMaxLength="40">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/groupNameInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:maxLength="40" android:inputType="textCapSentences" android:singleLine="true" android:imeOptions="actionNext" android:textAppearance="@style/Text.Group.Body15" android:hint="@string/group_ui_name_hint" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView android:id="@+id/groupSelectedCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:textAppearance="@style/Text.Group.Caption11" android:textColor="@color/group_ui_accent_text" />
            <com.google.android.material.chip.ChipGroup android:id="@+id/groupSelectedChips" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" app:chipSpacingHorizontal="8dp" app:chipSpacingVertical="4dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/group_ui_you_included" android:textAppearance="@style/Text.Group.Caption11" android:textColor="@color/group_ui_secondary" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="@string/group_ui_pick_members" android:textAppearance="@style/Text.Group.Body15" android:fontFamily="@font/manrope_bold" />
            <EditText android:id="@+id/groupCreateSearchInput" style="@style/Widget.Group.EditText" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" android:hint="@string/group_ui_find_contact" android:singleLine="true" android:inputType="text" android:imeOptions="actionSearch" android:drawableStart="@drawable/lucide_search" android:drawableTint="@color/group_ui_secondary" android:drawablePadding="12dp" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/groupMembersRecycler" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:nestedScrollingEnabled="false" tools:listitem="@layout/group_item_person" />
            <TextView android:id="@+id/groupCreateEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="24dp" android:gravity="center" android:text="@string/group_ui_no_contacts_found" android:textAppearance="@style/Text.Group.Label13" android:textColor="@color/group_ui_secondary" android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.google.android.material.button.MaterialButton android:id="@+id/groupCreateSubmitButton" style="@style/Widget.Group.PrimaryButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginStart="24dp" android:layout_marginEnd="24dp" android:layout_marginTop="8dp" android:layout_marginBottom="16dp" android:text="@string/group_ui_create" app:icon="@drawable/lucide_arrow_right" app:iconGravity="textEnd" app:iconTint="@color/group_ui_on_accent" />
</LinearLayout>
