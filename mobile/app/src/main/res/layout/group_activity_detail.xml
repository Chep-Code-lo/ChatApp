<?xml version='1.0' encoding='UTF-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:id="@id/groupScreenRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/group_ui_background" tools:context=".group.GroupDetailActivity">
    <include layout="@layout/group_toolbar"/>
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingBottom="24dp">
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" app:cardCornerRadius="28dp" app:cardElevation="0dp" app:strokeWidth="0dp" app:cardBackgroundColor="@color/group_ui_tint">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal" android:padding="24dp">
                    <com.google.android.material.card.MaterialCardView android:layout_width="76dp" android:layout_height="76dp" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:strokeWidth="0dp" app:cardBackgroundColor="@color/group_ui_accent">
                        <androidx.appcompat.widget.AppCompatImageView android:layout_width="38dp" android:layout_height="38dp" android:layout_gravity="center" app:srcCompat="@drawable/lucide_users" app:tint="@color/group_ui_on_accent" android:importantForAccessibility="no"/>
                    </com.google.android.material.card.MaterialCardView>
                    <TextView android:id="@+id/groupDetailName" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="center" android:textAppearance="@style/Text.Group.Headline22" android:maxLines="3"/>
                    <TextView android:id="@+id/groupDetailCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center" android:textAppearance="@style/Text.Group.Label13" android:textColor="@color/group_ui_accent_text"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton android:id="@+id/groupDetailAddMemberButton" style="@style/Widget.Group.PrimaryButton" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:text="@string/group_ui_add_members" app:icon="@drawable/lucide_plus" app:iconTint="@color/group_ui_on_accent" app:iconGravity="textStart"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/groupDetailInviteButton" style="@style/Widget.Group.OutlinedButton" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:layout_marginStart="12dp" android:text="@string/group_ui_share_invite" app:icon="@drawable/lucide_send" app:iconTint="@color/group_ui_text" app:iconGravity="textStart"/>
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="@string/group_ui_member_list" android:textAppearance="@style/Text.Group.Caption11" android:fontFamily="@font/manrope_bold" android:textColor="@color/group_ui_secondary"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="78dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingTop="12dp" android:paddingBottom="12dp">
                <com.google.android.material.card.MaterialCardView android:layout_width="48dp" android:layout_height="48dp" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:strokeWidth="0dp" app:cardBackgroundColor="@color/group_ui_accent">
                    <androidx.appcompat.widget.AppCompatImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" app:srcCompat="@drawable/lucide_user" app:tint="@color/group_ui_on_accent" android:importantForAccessibility="no"/>
                </com.google.android.material.card.MaterialCardView>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                    <TextView android:id="@+id/groupDetailSelfName" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/Text.Group.Body15" android:fontFamily="@font/manrope_bold"/>
                </LinearLayout>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/groupDetailMembersRecycler" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false" tools:listitem="@layout/group_item_person"/>

            <com.google.android.material.button.MaterialButton android:id="@+id/groupDetailLeaveButton" style="@style/Widget.Group.OutlinedButton" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="24dp" android:text="@string/group_ui_leave" android:textColor="@color/group_ui_danger" app:strokeColor="@color/group_ui_danger"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>