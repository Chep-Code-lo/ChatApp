<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="5dp" android:paddingBottom="7dp">
    <LinearLayout android:id="@+id/groupBubbleCluster" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="start" android:orientation="vertical">
        <TextView android:id="@+id/groupBubbleSender" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_marginBottom="4dp" android:textAppearance="@style/Text.Group.Caption" android:textColor="@color/group_ui_accent_text" />
        <LinearLayout android:id="@+id/groupBubbleBubble" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp" android:background="@drawable/group_bubble_incoming">
            <com.google.android.material.imageview.ShapeableImageView android:id="@+id/groupBubbleImage" android:layout_width="220dp" android:layout_height="160dp" android:scaleType="centerCrop" android:contentDescription="@string/group_ui_image_file" app:shapeAppearanceOverlay="@style/ShapeAppearance.Group.Attachment" android:visibility="gone" />
            <LinearLayout android:id="@+id/groupBubbleAttachment" android:layout_width="220dp" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
                <ImageView android:id="@+id/groupBubbleAttachmentIcon" android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/lucide_archive" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                    <TextView android:id="@+id/groupBubbleAttachmentName" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/Text.Group.Label" android:maxLines="2" android:ellipsize="end" />
                    <TextView android:id="@+id/groupBubbleAttachmentAction" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/group_ui_open_attachment" android:textAppearance="@style/Text.Group.Caption" />
                </LinearLayout>
            </LinearLayout>
            <TextView android:id="@+id/groupBubbleText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="250dp" android:textSize="15sp" android:fontFamily="@font/manrope_regular" android:lineSpacingExtra="3dp" android:textColor="@color/group_ui_text" />
        </LinearLayout>
        <TextView android:id="@+id/groupBubbleTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:layout_marginStart="6dp" android:layout_marginEnd="6dp" android:textAppearance="@style/Text.Group.Caption" android:textColor="@color/group_ui_secondary" />
    </LinearLayout>
</FrameLayout>
